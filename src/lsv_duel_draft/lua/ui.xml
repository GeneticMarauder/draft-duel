<!-- Top offsets clear Tabletop Simulator's own toolbar (about 70px tall). -->
<Panel id="statusPanel" rectAlignment="UpperCenter" offsetXY="0 -82" width="820" height="50" color="#000000CC">
  <Text id="statusText" fontSize="20" color="#FFFFFF" alignment="MiddleCenter">Loading...</Text>
</Panel>
<Button id="startButton" rectAlignment="UpperCenter" offsetXY="0 -140" width="240" height="44" fontSize="20"
        textColor="#FFFFFF" colors="#2E7D32|#388E3C|#1B5E20|#555555" onClick="onStartClicked">Start Draft</Button>
<Button id="resetViewButton" rectAlignment="UpperRight" offsetXY="-12 -120" width="140" height="36" fontSize="16"
        textColor="#FFFFFF" colors="#37474F|#455A64|#263238|#555555" onClick="onResetView">Reset view</Button>
<!-- Not top-right: Tabletop Simulator's player list swallows clicks there. The status bar is hidden while playing. -->
<Button id="nextGameButton" active="false" rectAlignment="UpperCenter" offsetXY="0 -82" width="240" height="40" fontSize="18"
        textColor="#FFFFFF" colors="#6A1B9A|#7B1FA2|#4A148C|#555555" onClick="onNextGameClicked">Next game</Button>
<Panel id="prompt_White" visibility="White" active="false" rectAlignment="LowerCenter" offsetXY="0 40" width="700" height="54" color="#B8860BEE">
  <Text fontSize="20" color="#FFFFFF" alignment="MiddleCenter">Your pick! Click Draft under a card (or right-click it, then Draft this card)</Text>
</Panel>
<Panel id="prompt_Red" visibility="Red" active="false" rectAlignment="LowerCenter" offsetXY="0 40" width="700" height="54" color="#B8860BEE">
  <Text fontSize="20" color="#FFFFFF" alignment="MiddleCenter">Your pick! Click Draft under a card (or right-click it, then Draft this card)</Text>
</Panel>
<Panel id="deck_White" visibility="White" active="false" rectAlignment="LowerCenter" offsetXY="0 24" width="780" height="124" color="#000000CC">
  <VerticalLayout padding="10 10 6 8" spacing="6">
    <Text id="deckText_White" fontSize="22" color="#FFD54F" alignment="MiddleCenter">Deck 0</Text>
    <HorizontalLayout spacing="8" preferredHeight="40">
      <Button id="land_White_Plains" onClick="onLandClicked" fontSize="18" textColor="#222222" colors="#E8DFC0|#F5EDD0|#CFC4A0|#555555">Plains  0</Button>
      <Button id="land_White_Island" onClick="onLandClicked" fontSize="18" textColor="#FFFFFF" colors="#3B7DD8|#5A97EA|#2C62AE|#555555">Island  0</Button>
      <Button id="land_White_Swamp" onClick="onLandClicked" fontSize="18" textColor="#FFFFFF" colors="#5B4A5E|#776279|#433545|#555555">Swamp  0</Button>
      <Button id="land_White_Mountain" onClick="onLandClicked" fontSize="18" textColor="#FFFFFF" colors="#C2452D|#D8604A|#9C3422|#555555">Mountain  0</Button>
      <Button id="land_White_Forest" onClick="onLandClicked" fontSize="18" textColor="#FFFFFF" colors="#2E7D46|#43995D|#225E34|#555555">Forest  0</Button>
    </HorizontalLayout>
    <Text fontSize="14" color="#FFFFFF" alignment="MiddleCenter">Left-click a land to add it, right-click to remove one. Drag cards to the right to sideboard them.</Text>
  </VerticalLayout>
</Panel>
<Panel id="deck_Red" visibility="Red" active="false" rectAlignment="LowerCenter" offsetXY="0 24" width="780" height="124" color="#000000CC">
  <VerticalLayout padding="10 10 6 8" spacing="6">
    <Text id="deckText_Red" fontSize="22" color="#FFD54F" alignment="MiddleCenter">Deck 0</Text>
    <HorizontalLayout spacing="8" preferredHeight="40">
      <Button id="land_Red_Plains" onClick="onLandClicked" fontSize="18" textColor="#222222" colors="#E8DFC0|#F5EDD0|#CFC4A0|#555555">Plains  0</Button>
      <Button id="land_Red_Island" onClick="onLandClicked" fontSize="18" textColor="#FFFFFF" colors="#3B7DD8|#5A97EA|#2C62AE|#555555">Island  0</Button>
      <Button id="land_Red_Swamp" onClick="onLandClicked" fontSize="18" textColor="#FFFFFF" colors="#5B4A5E|#776279|#433545|#555555">Swamp  0</Button>
      <Button id="land_Red_Mountain" onClick="onLandClicked" fontSize="18" textColor="#FFFFFF" colors="#C2452D|#D8604A|#9C3422|#555555">Mountain  0</Button>
      <Button id="land_Red_Forest" onClick="onLandClicked" fontSize="18" textColor="#FFFFFF" colors="#2E7D46|#43995D|#225E34|#555555">Forest  0</Button>
    </HorizontalLayout>
    <Text fontSize="14" color="#FFFFFF" alignment="MiddleCenter">Left-click a land to add it, right-click to remove one. Drag cards to the right to sideboard them.</Text>
  </VerticalLayout>
</Panel>
<Button id="ready_White" visibility="White" active="false" rectAlignment="LowerRight" offsetXY="-24 36" width="240" height="66" fontSize="22"
        textColor="#FFFFFF" colors="#2E7D32|#388E3C|#1B5E20|#555555" onClick="onReadyClicked">Ready to play</Button>
<Button id="ready_Red" visibility="Red" active="false" rectAlignment="LowerRight" offsetXY="-24 36" width="240" height="66" fontSize="22"
        textColor="#FFFFFF" colors="#2E7D32|#388E3C|#1B5E20|#555555" onClick="onReadyClicked">Ready to play</Button>
