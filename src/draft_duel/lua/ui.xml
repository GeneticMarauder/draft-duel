<!-- Top offsets clear Tabletop Simulator's own toolbar (about 70px tall).
     Each SEAT ... /SEAT block is repeated per seat, with its color filled in (tts_save.global_xml). -->
<Panel id="statusPanel" rectAlignment="UpperCenter" offsetXY="0 -82" width="820" height="50" color="#000000CC">
  <Text id="statusText" fontSize="20" color="#FFFFFF" alignment="MiddleCenter">Loading...</Text>
</Panel>
<Button id="startButton" rectAlignment="UpperCenter" offsetXY="0 -140" width="240" height="44" fontSize="20"
        textColor="#FFFFFF" colors="#2E7D32|#388E3C|#1B5E20|#555555" onClick="onStartClicked">Start Draft</Button>
<!-- Bottom right, above Ready to play: the top-right corner does not receive clicks. -->
<Button id="resetViewButton" rectAlignment="LowerRight" offsetXY="-24 112" width="140" height="36" fontSize="16"
        textColor="#FFFFFF" colors="#37474F|#455A64|#263238|#555555" onClick="onResetView">Reset view</Button>
<!-- Each seat's playmat button opens its picker (generated by tts_save.global_xml) mid-screen. -->
<!--SEAT-->
<Button id="matButton_{seat}" visibility="{seat}" rectAlignment="LowerRight" offsetXY="-24 156" width="240" height="36" fontSize="15"
        textColor="#FFFFFF" colors="#00695C|#00897B|#004D40|#555555" onClick="onMatButton">Playmat: None</Button>
<!--/SEAT-->
<!--MAT_PICKERS-->
<!-- Each seat's cube button (before the draft starts) opens its cube picker (generated by tts_save.cube_pickers). -->
<!--SEAT-->
<Button id="cubeButton_{seat}" visibility="{seat}" active="false" rectAlignment="LowerRight" offsetXY="-24 200" width="240" height="36" fontSize="15"
        textColor="#FFFFFF" colors="#283593|#3949AB|#1A237E|#555555" onClick="onCubeButton">Cube: ?</Button>
<!--/SEAT-->
<!--CUBE_PICKERS-->
<!-- In TTS's toolbar row, in the gap just left of the player list (not under it: that corner gets no clicks). -->
<Button id="nextGameButton" active="false" rectAlignment="UpperRight" offsetXY="-285 -14" width="240" height="44" fontSize="18"
        textColor="#FFFFFF" colors="#6A1B9A|#7B1FA2|#4A148C|#555555" onClick="onNextGameClicked">Next game</Button>
<!--SEAT-->
<Panel id="deck_{seat}" visibility="{seat}" active="false" rectAlignment="LowerCenter" offsetXY="0 24" width="780" height="124" color="#000000CC">
  <VerticalLayout padding="10 10 6 8" spacing="6">
    <Text id="deckText_{seat}" fontSize="22" color="#FFD54F" alignment="MiddleCenter">Deck 0</Text>
    <HorizontalLayout spacing="8" preferredHeight="40">
      <Button id="land_{seat}_Plains" onClick="onLandClicked" fontSize="18" textColor="#222222" colors="#E8DFC0|#F5EDD0|#CFC4A0|#555555">Plains  0</Button>
      <Button id="land_{seat}_Island" onClick="onLandClicked" fontSize="18" textColor="#FFFFFF" colors="#3B7DD8|#5A97EA|#2C62AE|#555555">Island  0</Button>
      <Button id="land_{seat}_Swamp" onClick="onLandClicked" fontSize="18" textColor="#FFFFFF" colors="#5B4A5E|#776279|#433545|#555555">Swamp  0</Button>
      <Button id="land_{seat}_Mountain" onClick="onLandClicked" fontSize="18" textColor="#FFFFFF" colors="#C2452D|#D8604A|#9C3422|#555555">Mountain  0</Button>
      <Button id="land_{seat}_Forest" onClick="onLandClicked" fontSize="18" textColor="#FFFFFF" colors="#2E7D46|#43995D|#225E34|#555555">Forest  0</Button>
    </HorizontalLayout>
    <Text fontSize="14" color="#FFFFFF" alignment="MiddleCenter">Left-click a land to add it, right-click to remove one. Drag cards to the right to sideboard them.</Text>
  </VerticalLayout>
</Panel>
<!--/SEAT-->
<!--SEAT-->
<Button id="ready_{seat}" visibility="{seat}" active="false" rectAlignment="LowerRight" offsetXY="-24 36" width="240" height="66" fontSize="22"
        textColor="#FFFFFF" colors="#2E7D32|#388E3C|#1B5E20|#555555" onClick="onReadyClicked">Ready to play</Button>
<!--/SEAT-->
